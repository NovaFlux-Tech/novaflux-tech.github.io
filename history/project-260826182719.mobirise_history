          "_customHTML": "<!-- ================================================================= -->\n<!-- PART 1 START: PARAMETERS, STYLES, AND HEADER SECTION             -->\n<!-- ================================================================= -->\n<section class=\"mbr-section website-pricing-section\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-fullscreen': fullScreen, 'mbr-parallax-background': bg.parallax}\" style=\"padding-top: calc({{paddingTop}} * 1rem); padding-bottom: calc({{paddingBottom}} * 1rem); background-color: @bgColor;\">\n\n<mbr-parameters>\n    <header>Size</header>\n    <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n    <input type=\"range\" inline title=\"Top Spacing\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n    <input type=\"range\" inline title=\"Bottom Spacing\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n    \n    <header>Background</header>\n    <fieldset type=\"background\" name=\"bg\" parallax>\n        <input type=\"image\" title=\"Background Image\" value=\"../_images/background.jpg\" parallax>\n        <input type=\"color\" title=\"Background Color\" name=\"bgColor\" value=\"#000918\" selected>\n        <input type=\"video\" title=\"Background Video\" value=\"https://youtube.com\">\n    </fieldset>\n    <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n    <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#232323\" condition=\"overlay && bg.type !== 'color'\">\n    <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.6\" condition=\"overlay && bg.type !== 'color'\">\n\n    <header>Fonts Selector</header>\n    <select title=\"Main Title Font\" name=\"titleFont\">\n        <option value=\"display-1\" selected>Title 1</option>\n        <option value=\"display-2\">Title 2</option>\n        <option value=\"display-5\">Title 5</option>\n    </select>\n    <select title=\"Card Header Font\" name=\"cardTitleFont\">\n        <option value=\"display-1\">Title 1</option>\n        <option value=\"display-2\" selected>Title 2</option>\n        <option value=\"display-5\">Title 5</option>\n    </select>\n    <select title=\"Prices Font\" name=\"priceFont\">\n        <option value=\"display-1\">Title 1</option>\n        <option value=\"display-2\" selected>Title 2</option>\n        <option value=\"display-5\">Title 5</option>\n    </select>\n    <select title=\"Features/Text Font\" name=\"bodyFont\">\n        <option value=\"display-7\" selected>Text</option>\n        <option value=\"display-4\">Menu Text</option>\n    </select>\n</mbr-parameters>\n\n<div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n</div>\n\n<style>\n    .website-pricing-section { background-color: @bgColor; }\n    .website-pricing-section .section-main-title { color: #00f2ff !important; font-weight: 700; letter-spacing: -0.5px; }\n    \n    .toggle-master-outer-box { display: flex; justify-content: center; width: 100%; margin-bottom: 3.5rem; }\n    .toggle-pricing-wrapper { display: block; position: relative; width: 100%; max-width: 320px; padding-top: 1.8rem; }\n    \n    .toggle-badge-absolute-position { position: absolute; top: 0; right: 0; width: 50%; text-align: center; }\n    .toggle-discount-tag { display: inline-block; background-color: #e0faff; color: #00bcd4; font-size: 0.75rem !important; font-weight: bold; padding: 0.15rem 0.5rem; border-radius: 4px; line-height: 1.2; text-align: center; }\n    \n    .toggle-action-row { display: inline-flex; background: #161c2a; padding: 0.3rem; border-radius: 50px; border: 1px solid #242f47; width: 100%; }\n    .toggle-action-btn { flex: 1; background: transparent; border: none; color: #718096; padding: 0.5rem 0; border-radius: 50px; font-weight: 600; cursor: pointer; transition: all 0.2s ease; text-align: center; }\n    .toggle-action-btn.active { background: #00f2ff; color: #0b0f19; }\n    \n    .pricing-card-surface { background-color: #111622 !important; border: 1px solid #1e2638 !important; border-radius: 1.5rem !important; padding: 3.5rem 2rem; text-align: center; display: flex; flex-direction: column; position: relative; overflow: hidden; box-shadow: 0 12px 40px rgba(0, 0, 0, 0.25); }\n    .pricing-card-surface .plan-title-string { color: #00f2ff !important; font-weight: 700; margin-bottom: 0.5rem; }\n    .pricing-card-surface .plan-subtitle-string { color: #00e5ff !important; margin-bottom: 2.5rem; line-height: 1.4; }\n    \n    .pricing-bullet-stack { list-style: none; padding: 0; margin: 0 0 3rem 0; display: flex; flex-direction: column; gap: 0.95rem; text-align: left; padding-left: 1.5rem; }\n    .pricing-bullet-stack li { color: #00e5ff; position: relative; line-height: 1.4; }\n    .pricing-bullet-stack li::before { content: \"✓\"; position: absolute; left: -1.5rem; top: 0; color: #00f2ff; font-weight: bold; font-family: sans-serif; }\n    \n    .pricing-currency-block { margin-top: auto; margin-bottom: 1.75rem; }\n    .pricing-currency-primary { font-weight: 800; color: #00f2ff; margin-bottom: 0.25rem; }\n    .pricing-currency-secondary { color: #00e5ff; }\n    \n    .pricing-action-anchor { background: transparent !important; color: #00f2ff !important; border: 2px solid #00f2ff !important; border-radius: 0.5rem !important; padding: 0.75rem 2rem !important; font-weight: bold !important; text-transform: none !important; transition: all 0.2s ease; display: inline-block; width: 85%; margin: 0 auto; text-decoration: none; text-align: center; }\n    .pricing-action-anchor:hover { background: #00f2ff !important; color: #0b0f19 !important; }\n    \n    .corner-banner-ribbon { position: absolute; top: 34px; right: -45px; transform: rotate(45deg); background: #00bcd4; color: #ffffff; font-weight: 400; width: 160px; text-align: center !important; padding: 0.25rem 0; letter-spacing: 0.5px; }\n\n    .pricing-monthly-view { display: none; }\n    .show-monthly .pricing-monthly-view { display: block; }\n    .show-monthly .pricing-yearly-view { display: none; }\n</style>\n\n<div id=\"pricing-matrix-container\" class=\"container\" style=\"position: relative; z-index: 2;\">\n    <div class=\"row justify-content-center mb-4\">\n        <div class=\"col-12 text-center\">\n            <h2 class=\"section-main-title mb-0\" mbr-class=\"['mbr-fonts-style', titleFont]\">Websites</h2>\n        </div>\n    </div>\n    \n    <div class=\"row justify-content-center\">\n        <div class=\"col-12 text-center\">\n            <div class=\"toggle-master-outer-box\">\n                <div class=\"toggle-pricing-wrapper\">\n                    <div class=\"toggle-badge-absolute-position\">\n                        <span class=\"toggle-discount-tag mbr-fonts-style\" style=\"font-size: 0.75rem !important;\">Save 15%</span>\n                    </div>\n                    <div class=\"toggle-action-row\">\n                        <button class=\"toggle-action-btn\" id=\"btn-m\" mbr-class=\"['mbr-fonts-style', bodyFont]\" onclick=\"document.getElementById('pricing-matrix-container').classList.add('show-monthly'); document.getElementById('btn-y').classList.remove('active'); this.classList.add('active');\">Billed Monthly</button>\n                        <button class=\"toggle-action-btn active\" id=\"btn-y\" mbr-class=\"['mbr-fonts-style', bodyFont]\" onclick=\"document.getElementById('pricing-matrix-container').classList.remove('show-monthly'); document.getElementById('btn-m').classList.remove('active'); this.classList.add('active');\">Billed Yearly</button>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n\n    <div class=\"row g-4 justify-content-center align-items-stretch\">\n<!-- ================================================================= -->\n<!-- PART 1 END                                                        -->\n<!-- ================================================================= -->\n<!-- ================================================================= -->\n<!-- PART 2 START: COLUMNS AND PRESENTATION DISPLAY GRIDS             -->\n<!-- ================================================================= -->\n        <!-- CARD 1: BASIC Plan -->\n        <div class=\"col-lg-4 col-md-6 d-flex flex-column\">\n            <div class=\"pricing-card-surface h-100\">\n                <h3 class=\"plan-title-string\" mbr-class=\"['mbr-fonts-style', cardTitleFont]\">Basic</h3>\n                <p class=\"plan-subtitle-string\" mbr-class=\"['mbr-fonts-style', bodyFont]\">Perfect for getting online fast</p>\n                <ul class=\"pricing-bullet-stack\">\n                    <li mbr-class=\"['mbr-fonts-style', bodyFont]\"><b>1 Page</b></li>\n                    <li mbr-class=\"['mbr-fonts-style', bodyFont]\">Contact Form</li>\n                    <li mbr-class=\"['mbr-fonts-style', bodyFont]\">Mobile-Friendly Design</li>\n                    <li mbr-class=\"['mbr-fonts-style', bodyFont]\">Hosting</li>\n                    <li mbr-class=\"['mbr-fonts-style', bodyFont]\">Free SSL</li>\n                    <li mbr-class=\"['mbr-fonts-style', bodyFont]\">Ongoing Management +<br>Basic Support Included</li>\n                </ul>\n                <div class=\"pricing-currency-block mt-auto\">\n                    <div class=\"pricing-currency-primary target-price\" mbr-class=\"['mbr-fonts-style', priceFont]\">R 800</div>\n                    <div class=\"pricing-yearly-view pricing-currency-secondary\" mbr-class=\"['mbr-fonts-style', bodyFont]\">Then R 834.80 per year</div>\n                    <div class=\"pricing-monthly-view pricing-currency-secondary\" mbr-class=\"['mbr-fonts-style', bodyFont]\">Then R 80 per month</div>\n                </div>\n                <a href=\"#\" class=\"pricing-yearly-view pricing-action-anchor\" mbr-class=\"['mbr-fonts-style', bodyFont]\">Pay yearly</a>\n                <a href=\"#\" class=\"pricing-monthly-view pricing-action-anchor\" mbr-class=\"['mbr-fonts-style', bodyFont]\">Pay monthly</a>\n            </div>\n        </div>\n\n        <!-- CARD 2: STANDARD Plan -->\n        <div class=\"col-lg-4 col-md-6 d-flex flex-column\">\n            <div class=\"pricing-card-surface h-100\">\n                <div class=\"corner-banner-ribbon\">MOST POPULAR</div>\n                <h3 class=\"plan-title-string\" mbr-class=\"['mbr-fonts-style', cardTitleFont]\">Standard</h3>\n                <p class=\"plan-subtitle-string\" mbr-class=\"['mbr-fonts-style', bodyFont]\">Great for growing businesses</p>\n                <ul class=\"pricing-bullet-stack\">\n                    <li mbr-class=\"['mbr-fonts-style', bodyFont]\"><b>Up to 5 Pages</b></li>\n                    <li mbr-class=\"['mbr-fonts-style', bodyFont]\">Contact Form + SEO Setup</li>\n                    <li mbr-class=\"['mbr-fonts-style', bodyFont]\"><b>1 Monthly Content Update</b></li>\n                    <li mbr-class=\"['mbr-fonts-style', bodyFont]\">Hosting</li>\n                    <li mbr-class=\"['mbr-fonts-style', bodyFont]\">Free SSL</li>\n                    <li mbr-class=\"['mbr-fonts-style', bodyFont]\">Full Management + Email +<br>Text Support</li>\n                </ul>\n                <div class=\"pricing-currency-block mt-auto\">\n                    <div class=\"pricing-currency-primary target-price\" mbr-class=\"['mbr-fonts-style', priceFont]\">R 1,800</div>\n                    <div class=\"pricing-yearly-view pricing-currency-secondary\" mbr-class=\"['mbr-fonts-style', bodyFont]\">Then R 1,356.52 per year</div>\n                    <div class=\"pricing-monthly-view pricing-currency-secondary\" mbr-class=\"['mbr-fonts-style', bodyFont]\">Then R 130 per month</div>\n                </div>\n                <a href=\"#\" class=\"pricing-yearly-view pricing-action-anchor\" mbr-class=\"['mbr-fonts-style', bodyFont]\">Pay yearly</a>\n                <a href=\"#\" class=\"pricing-monthly-view pricing-action-anchor\" mbr-class=\"['mbr-fonts-style', bodyFont]\">Pay monthly</a>\n            </div>\n        </div>\n\n        <!-- CARD 3: PREMIUM Plan -->\n        <div class=\"col-lg-4 col-md-6 d-flex flex-column\">\n            <div class=\"pricing-card-surface h-100\">\n                <div class=\"corner-banner-ribbon\" style=\"background: #00acc1 !important;\">BEST VALUE</div>\n                <h3 class=\"plan-title-string\" mbr-class=\"['mbr-fonts-style', cardTitleFont]\">Premium</h3>\n                <p class=\"plan-subtitle-string\" mbr-class=\"['mbr-fonts-style', bodyFont]\">Full online presence</p>\n                <ul class=\"pricing-bullet-stack\">\n                    <li mbr-class=\"['mbr-fonts-style', bodyFont]\"><b>Up to 10 Pages</b></li>\n                    <li mbr-class=\"['mbr-fonts-style', bodyFont]\">Blog / News Section</li>\n                    <li mbr-class=\"['mbr-fonts-style', bodyFont]\"><b>2 Monthly Content Updates</b></li>\n                    <li mbr-class=\"['mbr-fonts-style', bodyFont]\">Hosting</li>\n                    <li mbr-class=\"['mbr-fonts-style', bodyFont]\">Free SSL</li>\n                    <li mbr-class=\"['mbr-fonts-style', bodyFont]\">Full Management + Priority Support</li>\n                </ul>\n                <div class=\"pricing-currency-block mt-auto\">\n                    <div class=\"pricing-currency-primary target-price\" mbr-class=\"['mbr-fonts-style', priceFont]\">R 2,800</div>\n                    <div class=\"pricing-yearly-view pricing-currency-secondary\" mbr-class=\"['mbr-fonts-style', bodyFont]\">Then R 2,086.97 per year</div>\n                    <div class=\"pricing-monthly-view pricing-currency-secondary\" mbr-class=\"['mbr-fonts-style', bodyFont]\">Then R 200 per month</div>\n                </div>\n                <a href=\"#\" class=\"pricing-yearly-view pricing-action-anchor\" mbr-class=\"['mbr-fonts-style', bodyFont]\">Pay yearly</a>\n                <a href=\"#\" class=\"pricing-monthly-view pricing-action-anchor\" mbr-class=\"['mbr-fonts-style', bodyFont]\">Pay monthly</a>\n            </div>\n        </div>\n    </div>\n</div>\n</section>\n<!-- ================================================================= -->\n<!-- PART 2 END                                                        -->\n<!-- ================================================================= -->",
